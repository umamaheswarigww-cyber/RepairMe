# Browser-safe Supabase settings. These VITE_* variables are intentionally exposed to the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-side only. Never prefix these with VITE_ and never commit .env.local.
OPENROUTER_API_KEY=your-openrouter-api-key
# OpenRouter free model router (or another OpenRouter model identifier)
OPENROUTER_MODEL=openrouter/free
# Optional OpenRouter attribution header; use the final deployed URL in production.
PUBLIC_APP_URL=http://localhost:5173
